#!/usr/bin/env bash
set -euo pipefail
# Keep helper scripts (installed next to this launcher) resolvable from the
# session, so the shell can launch them by name.
bindir=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)
export PATH="$bindir:$PATH"
share=${TESSARCHY_DATA_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/tessarchy}
if [[ ! -f "$share/shell/shell.qml" ]]; then share=/usr/share/tessarchy; fi
[[ -f "$share/shell/shell.qml" ]] || { echo "Tessera source not installed" >&2; exit 1; }
# Load optional audio integration only when a PipeWire service socket exists.
export TESSARCHY_AUDIO=0
if [[ -S "${XDG_RUNTIME_DIR:-/run/user/$UID}/pipewire-0" ]]; then
    export TESSARCHY_AUDIO=1
fi
exec qs --no-duplicate --path "$share/shell/shell.qml" "$@"
